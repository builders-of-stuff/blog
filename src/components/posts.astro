---
import { getCollection } from "astro:content";

import FormattedDate from "./FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<div class="max-w-2xl mx-0 md:ml-24 lg:ml-32 px-6 py-16">
  <div class="space-y-16">
    {
      posts.map((post) => (
        <div>
          <h2 class="text-xl font-semibold tracking-tight text-slate-900 mb-2">
            <a href={`/blog/${post.slug}`} class="hover:text-blue-600">
              {post.data.title}
            </a>
          </h2>
          <div class="flex items-center gap-2 text-sm text-slate-600">
            <span class="font-medium">{post.data.author}</span>
            <span>·</span>
            <FormattedDate date={post.data.publishedAt} />
          </div>
        </div>
      ))
    }
  </div>
</div>
