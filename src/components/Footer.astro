---
import GithubIcon from "./github-icon.svelte";
import { GITHUB_URL } from "../consts";
---

<div class="fixed bottom-6 right-6">
  <a
    href={GITHUB_URL}
    target="_blank"
    class="text-slate-400 hover:text-slate-600 transition-colors"
    aria-label="Github"
  >
    <GithubIcon />
  </a>
</div>
